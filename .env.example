# Copia este archivo a `.env` (para desarrollo local) y rellena tus credenciales.
# Salen de https://cloud.livekit.io -> Settings -> Keys (o de tu servidor self-hosted).
#
# En Netlify NO uses archivos .env: configúralas en
# Site settings -> Environment variables (mismos nombres).
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
